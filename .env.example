# Copy to .env. Never commit a real API key.
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# Only sent to DeepSeek official API. Disabled for bounded structured role output.
MODEL_THINKING_ENABLED=false
# Match the actual provider/model window. Estimates use conservative UTF-8 bytes.
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_TOKENS=1024
# Per tool-message budget; retained records are complete, never sliced JSON.
CONTEXT_TOOL_RESULT_TOKENS=4096
# False = local TF-IDF by default (see LOCAL_RETRIEVAL_STRATEGY).
# True = BM25 + real embedding API + RRF.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# Local vector = TF-IDF word-frequency vector, not semantic embedding.
LOCAL_RETRIEVAL_STRATEGY=vector
# Optional: postgresql+psycopg://beeguide:beeguide@localhost:5432/beeguide
# DATABASE_URL=
WEATHER_ENABLED=true
# single = fixed workflow baseline; multi = bounded coordinator + advisor + reviewer.
AGENT_ARCHITECTURE=multi
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_TIMEOUT=30
AGENT_COORDINATION_TIMEOUT=100
